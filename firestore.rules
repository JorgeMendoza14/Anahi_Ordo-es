rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Correos de administradores (deben coincidir con ADMIN_EMAILS en js/firebase-config.js)
    function adminEmails() { return ['kevin@gmail.com']; }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.email in adminEmails()
        || (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
            && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin'));
    }

    // Perfiles: cada estudiante crea y edita el suyo (siempre con rol "estudiante").
    // Solo el admin puede ver a todos y cambiar roles.
    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.rol == 'estudiante'
        && request.resource.data.keys().hasOnly(['rol','nombre','email','telefono','curso','creado']);
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.rol == resource.data.rol);
      allow delete: if isAdmin();
    }

    // Catálogo y ajustes: cualquiera puede verlos, solo el admin los cambia.
    match /productos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /servicios/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pedidos: el estudiante con sesión crea los suyos (siempre "pendiente") y solo ve los suyos;
    // el admin ve todos, cambia su estado o los borra.
    match /pedidos/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','codigo','cliente','entrega','direccion','notas','items','total','estado','creado'])
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.creado == request.time
        && request.resource.data.codigo is string && request.resource.data.codigo.size() <= 10
        && request.resource.data.cliente.nombre is string
        && request.resource.data.cliente.nombre.size() > 0 && request.resource.data.cliente.nombre.size() <= 80
        && request.resource.data.cliente.telefono is string && request.resource.data.cliente.telefono.size() <= 20
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 100
        && request.resource.data.total is number && request.resource.data.total >= 0
        && request.resource.data.notas is string && request.resource.data.notas.size() <= 500;
    }
  }
}

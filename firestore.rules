rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    // Roles: solo se crean desde la consola de Firebase.
    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // Catálogo y ajustes: cualquiera puede verlos, solo el admin los cambia.
    match /productos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /servicios/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pedidos: el cliente crea uno nuevo (siempre "pendiente") y puede consultarlo
    // con su id; solo el admin puede listarlos, cambiar su estado o borrarlos.
    match /pedidos/{id} {
      allow get: if true;
      allow list, update, delete: if isAdmin();
      allow create: if
        request.resource.data.keys().hasOnly(['codigo','cliente','entrega','direccion','notas','items','total','estado','creado'])
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.creado == request.time
        && request.resource.data.codigo is string && request.resource.data.codigo.size() <= 10
        && request.resource.data.cliente.nombre is string
        && request.resource.data.cliente.nombre.size() > 0 && request.resource.data.cliente.nombre.size() <= 80
        && request.resource.data.cliente.telefono is string && request.resource.data.cliente.telefono.size() <= 20
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 100
        && request.resource.data.total is number && request.resource.data.total >= 0
        && request.resource.data.notas is string && request.resource.data.notas.size() <= 500;
    }
  }
}
